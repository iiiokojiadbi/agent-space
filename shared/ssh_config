# Ручной вход. Первая команда с ControlMaster auto сама становится мастером и
# создаёт сокет, следующие сессии цепляются к нему без повторной аутентификации:
#
#   ssh -N bpi     (одно окно, держит мастер-сокет)
#   ssh bpi        (второе окно, работа)
#
# portmap добавляет форварды в этот же мастер через `ssh -O forward`, поэтому
# отдельных соединений на каждый сервис не открывается.
#
# Если нужен прокси хоста на удалённой стороне — добавить в первую команду
# `-R 3128:127.0.0.1:3128`. Проброс Docker (`-R 2375`) больше не нужен: демон
# живёт на удалённой стороне.
Host bpi
    HostName 10.0.1.2
    User __REMOTE_USER__
    ControlMaster auto
    ControlPath /run/ssh-control/cm-%r@%h:%p.sock
    ServerAliveInterval 30
    ServerAliveCountMax 3
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /run/ssh-control/known_hosts
