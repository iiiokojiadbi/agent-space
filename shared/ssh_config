# Ручной вход. Первая команда с ControlMaster auto сама становится мастером и
# создаёт сокет, следующие сессии цепляются к нему без повторной аутентификации:
#
#   ssh -N bpi   (одно окно, держит мастер и оба обратных форварда)
#   ssh bpi      (второе окно, работа)
#
# portmap добавляет форварды в этот же мастер через `ssh -O forward`, поэтому
# отдельных соединений на каждый сервис не открывается.
#
# Обратные форварды объявлены здесь, а не в командной строке: список у них
# постоянный, а держать его в голове при каждом переоткрытии туннеля незачем.
#
#   2375 — docker daemon этой машины через links, нужен отладке
#   3128 — прокси этой машины: через него удалённая сторона ходит в корпоративную
#          сеть, ради адресов, которые больше ниоткуда не доступны
Host bpi
    HostName 10.0.1.2
    User __REMOTE_USER__
    RemoteForward 2375 127.0.0.1:2375
    RemoteForward 3128 127.0.0.1:3128
    ControlMaster auto
    ControlPath /run/ssh-control/cm-%r@%h:%p.sock
    # Порт на дальней стороне может быть ещё занят сессией, которую там не успели
    # закрыть. С `yes` (умолчание для -R не действует, но привычка тянет задать)
    # соединение оборвалось бы целиком; с `no` не встанет только этот форвард.
    ExitOnForwardFailure no
    # Клиент должен сам замечать смерть канала, иначе туннель висит мёртвым и
    # держит порты на дальней стороне.
    ServerAliveInterval 15
    ServerAliveCountMax 3
    # Гасит поток `channel N: open failed: connect failed: Connection refused`.
    # Он идёт, пока сервис за проброшенным портом лежит — например, когда Caddy
    # или сам сервис перезапускается, — и делает окно туннеля нечитаемым, ничего
    # при этом не сообщая. Разово вернуть вывод: `ssh -o LogLevel=INFO -N bpi`.
    LogLevel QUIET
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /run/ssh-control/known_hosts

# Цель для mutagen. Отличается от bpi только тем, что НЕ умеет создавать соединение
# сама: при живом мастере идёт через сокет (ProxyCommand не вызывается), а без
# мастера отказывает мгновенно, не открывая сети.
#
# Зачем: раньше mutagen ходил через bpi и при мёртвом мастере открывал по
# соединению на каждую sync-сессию, запрашивая пароль, которого в фоне ввести
# некому. Десяток таких попыток за секунду выглядит для защиты от подбора как
# атака — и мост банится целиком, вместе с ручным SSH и пробросом портов.
#
# ControlPath совпадает с bpi, поэтому мастер, поднятый руками, обслуживает и mutagen.
# Обратных форвардов здесь нет намеренно: их держит мастер, а дубль сломал бы его
# сессию попыткой занять те же порты.
Host bpi-sync
    HostName 10.0.1.2
    User __REMOTE_USER__
    ControlMaster no
    ControlPath /run/ssh-control/cm-%r@%h:%p.sock
    ProxyCommand /bin/false
    BatchMode yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /run/ssh-control/known_hosts
