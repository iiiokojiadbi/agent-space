#!/bin/bash
# Одно соединение дальней стороны к её выходу в сеть. socat слушателя запускает
# этот скрипт с nofork, и дескриптор 0 — само принятое соединение, без
# промежуточного процесса. Адреса и файл с текущим выбором — в окружении, его
# задаёт entrypoint.
#
# Параметры socat подобраны под туннели прокси и проверены на обоих видах
# полузакрытия:
#   FD:0,shut-down — сторона цели закрылась, и клиент тут же получает свой EOF.
#     STDIO так не умеет: на EOF он закрывает только дескриптор 1, а сокет жив
#     через дескриптор 0, и клиент ждёт до таймаута.
#   -t 30 — клиент закрыл передачу, а цель ещё отвечает. По умолчанию socat
#     ждёт её полсекунды и рвёт соединение, обрезая медленный ответ.
#
# Выбор делает цикл portmap раз в пять секунд, здесь он только читается. Пробы
# на каждое соединение нет намеренно: это лишнее обращение к отдельному прокси на
# каждый запрос дальней стороны.
case $(cat "$EGRESS_STATE" 2>/dev/null) in
	primary) exec socat -t 30 FD:0,shut-down "TCP:$EGRESS_PRIMARY,connect-timeout=2" ;;
	*)       exec socat -t 30 FD:0,shut-down "TCP:$EGRESS_FALLBACK,connect-timeout=2" ;;
esac
