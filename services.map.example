# <имя> <порт> — имя.dev.localhost → 127.0.0.1:<порт> на dev-машине
#
# Скопируй в services.map (gitignored) и допиши свои сервисы.
# portmap подхватывает изменения за ~5 секунд, gateway перезагружает Caddy сам —
# перезапускать ничего не нужно.
#
# Порт должен быть доступен на dev-машине по 127.0.0.1. Если сервис живёт не на
# ней самой, а дальше по цепочке, туннель до него держит сама dev-машина —
# со стороны хоста это по-прежнему обычный локальный порт.
portainer 9000
dev 3000
